{
  "name": "greenloop",
  "version": "1.0.0",
  "private": true,
  "description": "GreenLoop — AI-Powered Circular Waste-to-Resource Platform",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "matcher": "python3 -m uvicorn matcher.app:app --host 0.0.0.0 --port 8000",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:clean": "npm --prefix server run db:clean",
    "test": "npm --prefix server test",
    "test:matcher": "python3 -m unittest discover matcher/tests/"
  }
}
